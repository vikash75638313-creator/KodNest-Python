<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme -->
    <style name="Theme.LoginApp" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme (system-level instant splash) -->
    <style name="Theme.LoginApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#6650A4</item>
        <item name="windowSplashScreenAnimatedIcon">@android:drawable/ic_lock_lock</item>
        <item name="postSplashScreenTheme">@style/Theme.LoginApp</item>
    </style>
</resources>
